# ── Section rename: /flower-wall-tips/ → /flower-wall-guide/ (301 SEO redirect) ─
Redirect 301 /flower-wall-tips/ https://florinsky.ca/flower-wall-guide/
Redirect 301 /flower-wall-tips/real-touch-vs-silk-flower-wall/ https://florinsky.ca/flower-wall-guide/real-touch-vs-silk-flower-wall/

# ── Renamed product URL: midnight-bloom-burgundy → burgundy-flower-wall-rental ──
Redirect 301 /flower-walls/midnight-bloom-burgundy/ https://florinsky.ca/flower-walls/burgundy-flower-wall-rental/

# ── Retired orphan page: old standalone product.html → its real, live equivalent ─
Redirect 301 /product.html https://florinsky.ca/flower-walls/white-flower-wall-rental/

# ── SEO migration 2026-09-16: add "rental" commercial modifier to product slugs ──
Redirect 301 /flower-walls/green-flower-wall/ https://florinsky.ca/flower-walls/green-flower-wall-rental/
Redirect 301 /flower-walls/pink-flower-wall/ https://florinsky.ca/flower-walls/pink-flower-wall-rental/
Redirect 301 /flower-walls/white-flower-wall/ https://florinsky.ca/flower-walls/white-flower-wall-rental/
Redirect 301 /flower-walls/burgundy-flower-wall/ https://florinsky.ca/flower-walls/burgundy-flower-wall-rental/

# ── www → non-www canonical redirect ─────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.florinsky\.ca [NC]
    RewriteRule ^(.*)$ https://florinsky.ca/$1 [R=301,L]
    # ── IndexNow key file: served from css/ but must appear at site root ──────
    RewriteRule ^0f12b8ab36dd46148440857cd2ed1ae0\.txt$ css/0f12b8ab36dd46148440857cd2ed1ae0.txt [L]
    # ── SEO migration 2026-09-16: no-trailing-slash OLD product URLs (exact match only) ──
    RewriteRule ^flower-walls/green-flower-wall$ https://florinsky.ca/flower-walls/green-flower-wall-rental/ [R=301,L]
    RewriteRule ^flower-walls/pink-flower-wall$ https://florinsky.ca/flower-walls/pink-flower-wall-rental/ [R=301,L]
    RewriteRule ^flower-walls/white-flower-wall$ https://florinsky.ca/flower-walls/white-flower-wall-rental/ [R=301,L]
    RewriteRule ^flower-walls/burgundy-flower-wall$ https://florinsky.ca/flower-walls/burgundy-flower-wall-rental/ [R=301,L]
    # ── /flower-walls/* → served from flower-wall-guide/flower-walls/* ────────
    RewriteRule ^flower-walls/(.*)$ flower-wall-guide/flower-walls/$1 [L]
    # ── /locations/flower-wall-rental-toronto/* → served from flower-wall-guide/locations/flower-wall-rental-toronto/* ──
    RewriteRule ^locations/flower-wall-rental-toronto/(.*)$ flower-wall-guide/locations/flower-wall-rental-toronto/$1 [L]
    # ── /events/wedding-flower-wall-rental/* → served from flower-wall-guide/events/wedding-flower-wall-rental/* ──
    RewriteRule ^events/wedding-flower-wall-rental/(.*)$ flower-wall-guide/events/wedding-flower-wall-rental/$1 [L]
    # ── Canonicalize Mississauga page: /index.html and no-slash → pretty URL (301) ──
    RewriteRule ^locations/flower-wall-rental-mississauga/index\.html$ https://florinsky.ca/locations/flower-wall-rental-mississauga/ [R=301,L]
    RewriteRule ^locations/flower-wall-rental-mississauga$ https://florinsky.ca/locations/flower-wall-rental-mississauga/ [R=301,L]
    # ── /locations/flower-wall-rental-mississauga/* → served from flower-wall-guide/locations/flower-wall-rental-mississauga/* ──
    RewriteRule ^locations/flower-wall-rental-mississauga/(.*)$ flower-wall-guide/locations/flower-wall-rental-mississauga/$1 [L]
    # ── Canonicalize Brampton page: /index.html and no-slash → pretty URL (301) ──
    RewriteRule ^locations/flower-wall-rental-brampton/index\.html$ https://florinsky.ca/locations/flower-wall-rental-brampton/ [R=301,L]
    RewriteRule ^locations/flower-wall-rental-brampton$ https://florinsky.ca/locations/flower-wall-rental-brampton/ [R=301,L]
    # ── /locations/flower-wall-rental-brampton/* → served from flower-wall-guide/locations/flower-wall-rental-brampton/* ──
    RewriteRule ^locations/flower-wall-rental-brampton/(.*)$ flower-wall-guide/locations/flower-wall-rental-brampton/$1 [L]
    # ── Canonicalize Vaughan page: /index.html and no-slash → pretty URL (301) ──
    RewriteRule ^locations/flower-wall-rental-vaughan/index\.html$ https://florinsky.ca/locations/flower-wall-rental-vaughan/ [R=301,L]
    RewriteRule ^locations/flower-wall-rental-vaughan$ https://florinsky.ca/locations/flower-wall-rental-vaughan/ [R=301,L]
    # ── /locations/flower-wall-rental-vaughan/* → served from flower-wall-guide/locations/flower-wall-rental-vaughan/* ──
    RewriteRule ^locations/flower-wall-rental-vaughan/(.*)$ flower-wall-guide/locations/flower-wall-rental-vaughan/$1 [L]
    # ── Canonicalize Markham page: /index.html and no-slash → pretty URL (301) ──
    RewriteRule ^locations/flower-wall-rental-markham/index\.html$ https://florinsky.ca/locations/flower-wall-rental-markham/ [R=301,L]
    RewriteRule ^locations/flower-wall-rental-markham$ https://florinsky.ca/locations/flower-wall-rental-markham/ [R=301,L]
    # ── /locations/flower-wall-rental-markham/* → served from flower-wall-guide/locations/flower-wall-rental-markham/* ──
    RewriteRule ^locations/flower-wall-rental-markham/(.*)$ flower-wall-guide/locations/flower-wall-rental-markham/$1 [L]
    # ── Canonicalize Richmond Hill page: /index.html and no-slash → pretty URL (301) ──
    RewriteRule ^locations/flower-wall-rental-richmond-hill/index\.html$ https://florinsky.ca/locations/flower-wall-rental-richmond-hill/ [R=301,L]
    RewriteRule ^locations/flower-wall-rental-richmond-hill$ https://florinsky.ca/locations/flower-wall-rental-richmond-hill/ [R=301,L]
    # ── /locations/flower-wall-rental-richmond-hill/* → served from flower-wall-guide/locations/flower-wall-rental-richmond-hill/* ──
    RewriteRule ^locations/flower-wall-rental-richmond-hill/(.*)$ flower-wall-guide/locations/flower-wall-rental-richmond-hill/$1 [L]
    # ── Canonicalize Oakville page: /index.html and no-slash → pretty URL (301) ──
    RewriteRule ^locations/flower-wall-rental-oakville/index\.html$ https://florinsky.ca/locations/flower-wall-rental-oakville/ [R=301,L]
    RewriteRule ^locations/flower-wall-rental-oakville$ https://florinsky.ca/locations/flower-wall-rental-oakville/ [R=301,L]
    # ── /locations/flower-wall-rental-oakville/* → served from flower-wall-guide/locations/flower-wall-rental-oakville/* ──
    RewriteRule ^locations/flower-wall-rental-oakville/(.*)$ flower-wall-guide/locations/flower-wall-rental-oakville/$1 [L]
</IfModule>

# ── Block access to sensitive files (all directories, not just root) ──────────
<FilesMatch "(config\.php|config\.example\.php|\.env|\.env\.example|docker-compose\.yml|Dockerfile|\.gitignore)$">
    Require all denied
</FilesMatch>

# ── HTTP Security Headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Limit referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Force HTTPS — 1 day initially, extend to 1 year once stable
    Header always set Strict-Transport-Security "max-age=86400"

    # Disable browser features not needed by this site
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy
    # Allows: self, inline styles (needed for neumorphic design), Google Fonts,
    # Google Analytics, Microsoft Clarity, reCAPTCHA, YouTube nocookie embeds,
    # self-hosted media.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.gstatic.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; frame-src https://www.google.com https://www.youtube-nocookie.com; connect-src 'self' https://www.google-analytics.com https://www.google.com https://api.resend.com https://api.anthropic.com https://www.clarity.ms https://*.clarity.ms; object-src 'none'; base-uri 'self';"

    # Remove Apache version from headers
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── Disable directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── HTTP/2 — disable server push (avoids ERR_HTTP2_PROTOCOL_ERROR) ────────────
<IfModule mod_http2.c>
    H2Push off
</IfModule>

# ── HTML pages: no proxy/CDN caching (always serve fresh) ────────────────────
<FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always set Pragma "no-cache"
</FilesMatch>

# ── Browser caching for static assets ─────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 30 days"
    ExpiresByType image/png           "access plus 30 days"
    ExpiresByType image/webp          "access plus 30 days"
    ExpiresByType image/gif           "access plus 30 days"
    ExpiresByType image/svg+xml       "access plus 30 days"
    ExpiresByType video/mp4           "access plus 30 days"
    ExpiresByType video/webm          "access plus 30 days"
    # CSS/JS are always loaded with a "?v=N" cache-busting query string, so a
    # long lifetime here is safe: bumping the version, not the header, is what
    # forces a fresh fetch after an edit.
    ExpiresByType text/css            "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2          "access plus 365 days"
    ExpiresByType font/woff           "access plus 365 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ── PHP error display off (belt-and-suspenders alongside ini_set in PHP) ──────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
