# ── Section rename: /flower-wall-tips/ → /flower-wall-guide/ (301 SEO redirect) ─
Redirect 301 /flower-wall-tips/ https://florinsky.ca/flower-wall-guide/
Redirect 301 /flower-wall-tips/real-touch-vs-silk-flower-wall/ https://florinsky.ca/flower-wall-guide/real-touch-vs-silk-flower-wall/

# ── www → non-www canonical redirect ─────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.florinsky\.ca [NC]
    RewriteRule ^(.*)$ https://florinsky.ca/$1 [R=301,L]
</IfModule>

# ── Block access to sensitive files (all directories, not just root) ──────────
<FilesMatch "(config\.php|config\.example\.php|\.env|\.env\.example|docker-compose\.yml|Dockerfile|\.gitignore)$">
    Require all denied
</FilesMatch>

# ── HTTP Security Headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # Limit referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Force HTTPS — 1 day initially, extend to 1 year once stable
    Header always set Strict-Transport-Security "max-age=86400"

    # Disable browser features not needed by this site
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Content Security Policy
    # Allows: self, inline styles (needed for neumorphic design), Google Fonts,
    # Google Analytics, reCAPTCHA, YouTube nocookie embeds, self-hosted media.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; frame-src https://www.youtube-nocookie.com https://www.google.com; connect-src 'self' https://www.google-analytics.com https://www.google.com https://api.resend.com https://api.anthropic.com; object-src 'none'; base-uri 'self';"

    # Remove Apache version from headers
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── Disable directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── HTTP/2 — disable server push (avoids ERR_HTTP2_PROTOCOL_ERROR) ────────────
<IfModule mod_http2.c>
    H2Push off
</IfModule>

# ── Browser caching for static assets ─────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg          "access plus 30 days"
    ExpiresByType image/png           "access plus 30 days"
    ExpiresByType image/webp          "access plus 30 days"
    ExpiresByType image/gif           "access plus 30 days"
    ExpiresByType image/svg+xml       "access plus 30 days"
    ExpiresByType video/mp4           "access plus 7 days"
    ExpiresByType video/webm          "access plus 7 days"
    ExpiresByType text/css            "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2          "access plus 365 days"
    ExpiresByType font/woff           "access plus 365 days"
</IfModule>

# ── PHP error display off (belt-and-suspenders alongside ini_set in PHP) ──────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
